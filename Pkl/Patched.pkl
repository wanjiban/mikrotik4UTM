module Patched

import "./URL.pkl"
import "./SVG.pkl"

class PatchedVersion {
  name: String
  arch: "x86_64" | "aarch64"
  product: "chr" = "chr"

  _resolvedVersion: String = _resolveVersion(name, arch)
  _archTag: String = if (arch == "x86_64") "" else "-" + arch.replaceAll("aarch64", "arm64")
  _releaseTag: String = "\(_resolvedVersion)\(_archTag)"

  downloadUrl: URL.Download = new {
    name = "\(product)-\(_resolvedVersion)\(_archTag).\(_imageType)"
    url = "https://github.com/elseif/MikroTikPatch/releases/download/\(_releaseTag)/\(product)-\(_releaseTag).\(_imageType)"
    filename = "\(product)-\(_resolvedVersion)\(_archTag).img"
  }

  _imageType: String = "img.zip"

  function _resolveVersion(versionName: String, archName: String): String =
    if (versionName == "stable" && archName == "aarch64")
      read("https://upgrade.mikrotik.ltd/routeros/NEWESTa7.stable").text.split(" ")[0] + "-arm64"
    else if (versionName == "stable")
      read("https://upgrade.mikrotik.ltd/routeros/NEWESTa7.stable").text.split(" ")[0]
    else if (versionName == "testing" && archName == "aarch64")
      read("https://upgrade.mikrotik.ltd/routeros/NEWESTa7.testing").text.split(" ")[0] + "-arm64"
    else if (versionName == "testing")
      read("https://upgrade.mikrotik.ltd/routeros/NEWESTa7.testing").text.split(" ")[0]
    else
      versionName
}

class PatchedIcon extends SVG.Icon {
  name: String = "mikrotik_patched.svg"
  style: "solid"|"line"? = null
  fill: String? = "#00ff00"
  text: String = """
  <?xml version="1.0" encoding="UTF-8"?>
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 41.83 44.62">
      <path d="M41.83,13.83c0-1.77-.96-3.4-2.5-4.26L23.3.62c-1.48-.83-3.28-.83-4.76,0L2.5,9.57c-1.54.86-2.5,2.49-2.5,4.26v17.08c0,1.78.97,3.42,2.53,4.28l16.04,8.82c1.46.81,3.24.81,4.7,0l16.04-8.82c1.56-.86,2.53-2.5,2.53-4.28V13.83Z" fill="#00ff00"/>
  </svg>
  """
}
