open module chr-patched.utmzip
extends "../Pkl/utmzip.pkl"
import "../Pkl/Patched.pkl"

name = baseName
baseName = "chr-patched.\(architecture).\(backend.toLowerCase()).\(patchedVersion.version)"

cpus = 2
memory = 1.gib

imageDownloadUrl = patchedVersion.downloadUrl

additionalDisks: List<DataSize> = List()

notes = """
\(name)
MikroTik RouterOS CHR (Patched) for UTM's \(backend) Virtualization on \(architecture).

使用 mikrotik.ltd 提供的已修补镜像。

默认用户名是 'admin'，无密码。

更多信息请参阅 https://mikrotik.ltd/
"""

logoSvg = new Patched.PatchedIcon {}

patchedVersion: Patched.PatchedVersion = new Patched.PatchedVersion {
  name = read?("env:CHR_VERSION") ?? "stable"
  arch = outer.architecture
    .replaceAll("x86_64","x86_64")
    .replaceAll("aarch64","aarch64")
}
